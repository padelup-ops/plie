+    /// RetroFold: a copy of the picked firmware in the app's own temporary folder. The installation carries on in
+    /// the background after access to the picked file has been given back, and could no longer read the original.
+    static public func localFirmwareCopy(of url: URL) throws -> URL {
+        let scoped = url.startAccessingSecurityScopedResource()
+        defer { if scoped { url.stopAccessingSecurityScopedResource() } }
+        let folder = FileManager.default.temporaryDirectory.appendingPathComponent("retrofold-firmware", isDirectory: true)
+        try? FileManager.default.removeItem(at: folder)
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+        // The core only knows ".zip" in lower case.
+        let name = url.pathExtension.lowercased() == "zip" ? "firmware.zip" : url.lastPathComponent
+        let copy = folder.appendingPathComponent(name)
+        try FileManager.default.copyItem(at: url, to: copy)
+        return copy
+    }
