# Modèle de variables d'environnement du backend PadelUp (copier en .env pour le développement local).
# Ne jamais committer le vrai .env.
DEBUG=True
SECRET_KEY=change-me-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Connexion Google : identifiants OAuth (clients iOS, Android, web) séparés par des virgules. Sans eux, Google est refusé.
GOOGLE_CLIENT_IDS=
# Connexion Apple : identifiants des apps (bundle ID) acceptés
APPLE_CLIENT_ID=com.padelup.padelup-new,com.padelup.padelUp,com.padelup.neo

# Hébergement des photos (freeimage.host). Clé à régénérer : l'ancienne était publiée dans le code.
FREEIMAGE_API_KEY=

# Bot de réservation
# Clé de chiffrement des jetons Playtomic / Anybuddy :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOT_ENCRYPTION_KEY=
# Secret pour un cron externe qui appelle POST /api/bot/tick/ (en-tête X-Bot-Secret), si aucun worker ne tourne
BOT_CRON_SECRET=
# true = le bot va jusqu'au paiement Playtomic sans confirmer (tests avec un vrai compte)
PLAYTOMIC_DRY_RUN=false
# Clé web publique Firebase d'Anybuddy (connexion des comptes Anybuddy par e-mail)
ANYBUDDY_FIREBASE_API_KEY=

# Domaines du tableau de bord autorisés (CORS) et origines de confiance (CSRF), séparés par des virgules
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# E-mails : console en local, SMTP en production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=ssl0.ovh.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@padelup.com

# Notifications push (Firebase Cloud Messaging) et suivi d'erreurs
FIREBASE_CREDENTIALS_JSON=
SENTRY_DSN=
